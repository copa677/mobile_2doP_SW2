# ====================================================================
# APEX FITNESS PLATFORM - CONFIGURACIÓN MÓVIL (EXPO) - EJEMPLO
# Copia este archivo como .env y ajusta la IP local de tu máquina
# ====================================================================

# Dirección IP de tu PC o Servidor en la misma red Wi-Fi
EXPO_PUBLIC_SERVER_HOST=192.168.1.12

# API Gateway (Autenticación SSO y Enrutamiento Central - Puerto 3000)
EXPO_PUBLIC_API_GATEWAY_URL=http://192.168.1.12:3000

# Proveedor de Identidad MS-Auth (SSO / OIDC - Puerto 4000)
EXPO_PUBLIC_MS_AUTH_URL=http://192.168.1.12:4000

# Microservicio MS-Gimnasio (GraphQL - Membresías, Accesos y Torniquetes - Puerto 8082)
EXPO_PUBLIC_MS_GIMNASIO_GRAPHQL=http://192.168.1.12:8082/graphql

# Microservicio MS-Entrenamiento (GraphQL - Mesociclos y Rutinas Semanales - Puerto 8083)
EXPO_PUBLIC_MS_ENTRENAMIENTO_GRAPHQL=http://192.168.1.12:8083/graphql

# Microservicio MS-Inventario (REST - Catálogo y Suplementos - Puerto 8084)
EXPO_PUBLIC_MS_INVENTARIO_URL=http://192.168.1.12:8084

# Backend BFF / Servicio de Reportes Financieros y Métricas (Puerto 8000)
EXPO_PUBLIC_BFF_URL=http://192.168.1.12:8000/api/v1

