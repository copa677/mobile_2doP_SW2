# ====================================================================
# APEX FITNESS PLATFORM - CONFIGURACIÓN MÓVIL (EXPO)
# Variables accesibles en tiempo de ejecución móvil con prefijo EXPO_PUBLIC_
# ====================================================================

# OPCIÓN 1: PRODUCCIÓN / DESPLIEGUE EN VIVO
# Dominio Central de Producción Desplegado
EXPO_PUBLIC_SERVER_HOST=apexfitness.bratox.me

# API Gateway (BFF Central / Autenticación SSO)
EXPO_PUBLIC_API_GATEWAY_URL=https://apexfitness.bratox.me

# Proveedor de Identidad MS-Auth (OIDC)
EXPO_PUBLIC_MS_AUTH_URL=https://apexfitness.bratox.me

# Microservicio MS-Gimnasio (GraphQL)
EXPO_PUBLIC_MS_GIMNASIO_GRAPHQL=https://apexfitness.bratox.me/graphql/gimnasio

# Microservicio MS-Entrenamiento (GraphQL)
EXPO_PUBLIC_MS_ENTRENAMIENTO_GRAPHQL=https://apexfitness.bratox.me/graphql/entrenamiento

# Microservicio MS-Inventario (GraphQL)
EXPO_PUBLIC_MS_INVENTARIO_URL=https://apexfitness.bratox.me/graphql/inventario

# Backend BFF / API Gateway
EXPO_PUBLIC_BFF_URL=https://apexfitness.bratox.me/api

# Microservicio MS-MCP (Reportes Dinámicos & Analytics)
EXPO_PUBLIC_MS_MCP_URL=https://apexfitness.bratox.me/api/reportes
EXPO_PUBLIC_MS_MCP_TOKEN=mcp_gateway_1f2e3d4c5b6a7f8e9d0c1b2a3f4e5d6c

# --------------------------------------------------------------------
# OPCIÓN 2: ENTORNO LOCAL (DESARROLLO EN TU RED WIFI)
# Descomentar si deseas volver a probar contra tus contenedores Docker locales:
# EXPO_PUBLIC_SERVER_HOST=192.168.1.12
# EXPO_PUBLIC_API_GATEWAY_URL=http://192.168.1.12:3000
# EXPO_PUBLIC_MS_AUTH_URL=http://192.168.1.12:4000
# EXPO_PUBLIC_MS_GIMNASIO_GRAPHQL=http://192.168.1.12:8082/graphql
# EXPO_PUBLIC_MS_ENTRENAMIENTO_GRAPHQL=http://192.168.1.12:8083/graphql
# EXPO_PUBLIC_MS_INVENTARIO_URL=http://192.168.1.12:8084
# EXPO_PUBLIC_BFF_URL=http://192.168.1.12:8000/api/v1
# EXPO_PUBLIC_MS_MCP_URL=http://192.168.1.12:8090/api/v1
