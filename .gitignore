# ====================================================================
# APEX FITNESS MOBILE - .gitignore
# ====================================================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Variables de entorno y secretos
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Builds nativos generados (prebuilds)
/ios
/android

# Archivos de certificados y llaves nativas
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
google-services.json
GoogleService-Info.plist

# Logs y Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.metro-health-check*

# TypeScript
*.tsbuildinfo

# Modelos locales de IA y binarios pesados de pruebas
*.gguf
*.bin
*.weights

# Sistema Operativo y Editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.agents/
